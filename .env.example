# ---------------------------------------------------------------- core
ENVIRONMENT=production
SECRET_KEY=replace-with-64-random-characters
ADMIN_EMAIL=you@yourcompany.in
ADMIN_PASSWORD=replace-me
# Public URL of the API (unsubscribe links in emails point here — must be reachable from the internet)
PUBLIC_BASE_URL=https://leads-api.yourcompany.in
DASHBOARD_URL=https://leads.yourcompany.in
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leads
# Only needed when running outside docker-compose:
# DATABASE_URL=postgresql+psycopg://leads:change-me@localhost:5432/leads
# REDIS_URL=redis://localhost:6379/0

TARGET_CLUSTERS=["Bhiwadi","Khushkhera","Tapukara","Neemrana"]

# ---------------------------------------------------------------- AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------- web search (optional but recommended)
# serpapi | google_cse | none   — enables company discovery, web-search sources and contact search
SEARCH_PROVIDER=none
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------- crawler etiquette
CRAWLER_USER_AGENT=LeadEngineBot/1.0 (business research; contact: you@yourcompany.in)
CRAWLER_DELAY_SECONDS=3
CRAWLER_RESPECT_ROBOTS=true

# ---------------------------------------------------------------- sender identity (appears in every email)
SENDER_NAME=Your Name
SENDER_TITLE=Business Development Manager
SENDER_EMAIL=you@yourcompany.in
SENDER_COMPANY=Your Company Pvt Ltd
SENDER_PHONE=+91-9xxxxxxxxx
SENDER_WEBSITE=https://yourcompany.in
SENDER_ADDRESS=Plot X, RIICO Industrial Area, Bhiwadi, Rajasthan 301019
SENDER_OFFERING=PEB structures, industrial civil construction, factory and warehouse buildings, turnkey EPC
# Only verifiable claims — the AI may quote these verbatim and nothing else about you
SENDER_CREDENTIALS=
REPLY_TO=
UNSUBSCRIBE_MAILTO=

# ---------------------------------------------------------------- SMTP / IMAP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------- email automation defaults
# (all of these can be changed later from Dashboard → Settings)
# dry_run: nothing is sent, emails are rendered + logged
# approval: drafts wait for a human to approve in the dashboard
# auto: drafts for leads >= AUTO_SEND_MIN_GRADE are sent automatically
EMAIL_SEND_MODE=dry_run
OUTREACH_MIN_GRADE=HIGH
AUTO_SEND_MIN_GRADE=HOT
DAILY_SEND_LIMIT=30
HOURLY_SEND_LIMIT=8
PER_DOMAIN_DAILY_LIMIT=1
MIN_SECONDS_BETWEEN_SENDS=120
SEND_WINDOW_START_HOUR=10
SEND_WINDOW_END_HOUR=18
SEND_ON_WEEKENDS=false
FOLLOWUP_DELAYS_DAYS=[4,7]
MAX_FOLLOWUPS=2
COMPANY_COOLDOWN_DAYS=45

# ---------------------------------------------------------------- notifications
NOTIFY_MIN_GRADE=HIGH
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL=

# Set true when the dashboard is served over HTTPS
COOKIE_SECURE=false
